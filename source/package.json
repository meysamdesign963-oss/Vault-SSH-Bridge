{
  "name": "obsidian-vault-ssh-bridge",
  "version": "1.0.0",
  "description": "Embedded SSH server inside Obsidian, sandboxed to the vault — designed for AI assistants.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:js": "node esbuild.config.mjs production",
    "build:core": "node esbuild.config.mjs test",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "npm run build:core && node test/run-test.cjs"
  },
  "dependencies": {
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ssh2": "^1.15.4",
    "esbuild": "^0.21.5",
    "obsidian": "^1.5.7",
    "typescript": "^5.4.5"
  }
}
